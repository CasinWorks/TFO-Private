# Production (current Vercel preview domains)
VITE_PARENT_URL=https://private-tfo.vercel.app
VITE_JETS_URL=https://jets-six.vercel.app
VITE_LIMOUSINE_URL=https://limousine-tfo.vercel.app

# Iceland Limousine staff RBAC (limousine app only — set in Vercel env)
VITE_OWNER_EMAIL=owner@icelandlimousine.com
VITE_OWNER_PASSWORD=change-me
VITE_ADMIN_EMAIL=admin@admin.com
VITE_ADMIN_PASSWORD=admin
VITE_DISPATCHER_EMAIL=dispatch@icelandlimousine.com
VITE_DISPATCHER_PASSWORD=change-me

# Limousine booking emails (Vercel server env for apps/limousine — not VITE_)
# Swap BOOKING_NOTIFY_EMAIL to change who receives new booking alerts.
RESEND_API_KEY=re_xxxxxxxx
BOOKING_NOTIFY_EMAIL=christianjoshuacasin@gmail.com
BOOKING_FROM_EMAIL=beth.t@example.com
BOOKING_FROM_NAME=Iceland Limousine
